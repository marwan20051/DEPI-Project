    {
      "parameters": {
        "jsCode": "const req = $('When Executed by Another Workflow').first().json;\nconst emp = $input.first().json;\n\nconst leaveTypeIds = {\n  annual: '960a1349-48f8-4bfd-b7a5-02945ae262cc',\n  sick:   'ad509067-ec18-4a73-90ef-650d971517c9',\n  unpaid: 'e10c702e-8504-4464-8339-10b0249f1263',\n  other:  'ef5b76cc-2add-4d26-a9bd-a2f3efc519f7'\n};\nconst type = String(req.leave_type || '').trim().toLowerCase();\nconst days = Math.round((new Date(req.end_date) - new Date(req.start_date)) / 86400000) + 1;\n\nlet valid = true, reason = '';\nif (!emp.employee_id) {\n  valid = false; reason = 'Employee could not be verified.';\n} else if (!leaveTypeIds[type]) {\n  valid = false; reason = 'Unknown leave type. Available: annual, sick, unpaid, other.';\n} else if (isNaN(days) || days < 1) {\n  valid = false; reason = 'The dates are invalid or the end date is before the start date.';\n} else if (type === 'annual' && Number(emp.annual_leave_balance_days) < days) {\n  valid = false; reason = `Not enough annual leave: ${emp.annual_leave_balance_days} days available, ${days} requested.`;\n}\n\nreturn [{ json: {\n  valid, reason, days,\n  leave_type: type,\n  leave_type_id: leaveTypeIds[type],\n  employee_id: emp.employee_id,\n  employee_number: emp.employee_number,\n  full_name: emp.full_name,\n  employee_email: emp.email,\n  start_date: req.start_date,\n  end_date: req.end_date,\n  employee_note: req.employee_note || ''\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
